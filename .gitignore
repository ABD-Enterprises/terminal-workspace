.DS_Store
.env
node_modules/
.pnpm-store/
apps/desktop/dist/
src-tauri/target/
# #170: tauri_build::build() regenerates src-tauri/gen/schemas on every build from
# capabilities/ plus the resolved tauri dependency versions. Build output, like
# target/ above — committing it would churn on every Tauri or plugin bump without
# adding a gate, since the real check is that the build now validates capabilities
# rather than that a snapshot is stored. capabilities/default.json's "$schema"
# reference resolves after the first local build.
src-tauri/gen/
playwright-report/
test-results/
artifacts/e2e/
artifacts/validation/
# Build output from native:bundle / native:notarize. Manifests, signed
# archives, codesign + spctl + stapler logs all land here. Recreated by
# every build; should not be tracked.
artifacts/release/

*.tsbuildinfo

# Per-session Claude Code editor state (scheduled_tasks.lock holds the
# active session id + pid). Local to the developer; never part of the
# repo.
.claude/

# Pipeline state and retained evidence files must not be gitignored — they are required by the AI validator
.worktrees/

# The desktop app is built through the pnpm workspace; an npm lockfile here
# would describe a divergent dependency tree (see #176).
apps/desktop/package-lock.json
